# Copy to .env and fill in. Required only for the phase that uses them.

# --- Phase 2/3: ERL extraction via OpenAI structured outputs ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Override the extraction model (default in src/aionis/config.py).
# Use a current model that supports strict structured outputs.
# Keep commented: an empty value would override the default with "".
# OPENAI_MODEL=gpt-4o-mini

# --- Phase 0: scheduled event dates via FRED ---
# Get from https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# --- LLM provider router: additional OpenAI-compatible keys (multi-key
# policy router, src/aionis/extraction/providers.py) ---
MODELSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# --- Market data ---
# Tiingo: free-tier EOD daily prices — token at https://tiingo.com
TIINGO_API_KEY=
# Alpaca: one key + secret serve the paper-trading API and the market-data
# endpoint (data.alpaca.markets) — https://alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- LLM endpoint overrides (OpenAI-compatible; llm_model overrides
# openai_model when set, src/aionis/config.py) ---
# Provider selection (settings.provider, src/aionis/extraction/llm_client.py
# make_llm_client): openai (config default) | router (all enabled providers
# with failover) | glm | siliconflow | modelscope. An empty value falls back
# to "router" (falsy fallback in make_llm_client) — set it explicitly when
# you want the OpenAI-strict path. glm additionally requires LLM_MODEL pinned
# below (fail-closed, src/aionis/extraction/providers.py).
PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
